typedef struct {
    int dx;
    int dy;
} Slope;

// Helper function to calculate the Greatest Common Divisor (GCD)
int gcd(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

// Comparison function for qsort to group identical slopes together
int compareSlopes(const void *a, const void *b) {
    Slope *s1 = (Slope *)a;
    Slope *s2 = (Slope *)b;
    if (s1->dx != s2->dx) {
        return s1->dx - s2->dx;
    }
    return s1->dy - s2->dy;
}
int maxPoints(int** points, int pointsSize, int* pointsColSize) {
    if (pointsSize <= 2) {
        return pointsSize;
    }
    
    int maxTotal = 1;
    Slope* slopes = (Slope*)malloc(sizeof(Slope) * pointsSize);
    
    for (int i = 0; i < pointsSize; i++) {
        int slopeCount = 0;
        int duplicates = 0;
        int x1 = points[i][0];
        int y1 = points[i][1];
        
        for (int j = i + 1; j < pointsSize; j++) {
            int x2 = points[j][0];
            int y2 = points[j][1];
            
            int dx = x2 - x1;
            int dy = y2 - y1;
            
            if (dx == 0 && dy == 0) {
                duplicates++;
                continue;
            }
            
            int g = gcd(dx, dy);
            dx /= g;
            dy /= g;
            
            // Normalize sign representation for consistent sorting
            if (dx < 0 || (dx == 0 && dy < 0)) {
                dx = -dx;
                dy = -dy;
            }
            
            slopes[slopeCount].dx = dx;
            slopes[slopeCount].dy = dy;
            slopeCount++;
        }
        
        // Sort slopes to count consecutive duplicates
        qsort(slopes, slopeCount, sizeof(Slope), compareSlopes);
        
        int currentMax = 0;
        int k = 0;
        while (k < slopeCount) {
            int count = 0;
            Slope currentSlope = slopes[k];
            while (k < slopeCount && slopes[k].dx == currentSlope.dx && slopes[k].dy == currentSlope.dy) {
                count++;
                k++;
            }
            if (count > currentMax) {
                currentMax = count;
            }
        }
        
        // Local max includes anchor point (1) + duplicates + max identical slopes found
        int totalForPoint = currentMax + duplicates + 1;
        if (totalForPoint > maxTotal) {
            maxTotal = totalForPoint;
        }
    }
    
    free(slopes);
    return maxTotal;
}
