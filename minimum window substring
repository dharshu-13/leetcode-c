char* minWindow(char* s, char* t) {

    if (!s || !t || *s == '\0' || *t == '\0') return "";

    int count_t[128] = {0};
    int window_counts[128] = {0};
    
    int len_s = strlen(s);
    int len_t = strlen(t);
    
    int required = 0;
    for (int i = 0; i < len_t; i++) {
        if (count_t[(unsigned char)t[i]] == 0) {
            required++; 
        }
        count_t[(unsigned char)t[i]]++;
    }
    
    int left = 0, right = 0;
    int formed = 0;
    
    int min_len = INT_MAX;
    int min_left = 0;
    
    while (right < len_s) {
        char c = s[right];
        window_counts[(unsigned char)c]++;
        
        if (count_t[(unsigned char)c] > 0 && window_counts[(unsigned char)c] == count_t[(unsigned char)c]) {
            formed++;
        }
        
        while (left <= right && formed == required) {
            char left_c = s[left];
            
            if (right - left + 1 < min_len) {
                min_len = right - left + 1;
                min_left = left;
            }
            
            window_counts[(unsigned char)left_c]--;
            if (count_t[(unsigned char)left_c] > 0 && window_counts[(unsigned char)left_c] < count_t[(unsigned char)left_c]) {
                formed--;
            }
            
            left++;
        }
        right++;
    }
    
    if (min_len == INT_MAX) {
        return "";
    }
    
    s[min_left + min_len] = '\0';
    return &s[min_left];
}
 
