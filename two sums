#include <stdlib.h>

// Structure for hash map nodes
struct HashNode {
    int key;
    int value;
    struct HashNode* next;
};

// Simple hash map implementation
struct HashMap {
    int size;
    struct HashNode** buckets;
};

struct HashMap* createMap(int size) {
    struct HashMap* map = (struct HashMap*)malloc(sizeof(struct HashMap));
    map->size = size;
    map->buckets = (struct HashNode**)calloc(size, sizeof(struct HashNode*));
    return map;
}

int hash(int key, int size) {
    int h = key % size;
    return h < 0 ? h + size : h; // Handle negative keys
}

void insert(struct HashMap* map, int key, int value) {
    int idx = hash(key, map->size);
    struct HashNode* newNode = (struct HashNode*)malloc(sizeof(struct HashNode));
    newNode->key = key;
    newNode->value = value;
    newNode->next = map->buckets[idx];
    map->buckets[idx] = newNode;
}

struct HashNode* search(struct HashMap* map, int key) {
    int idx = hash(key, map->size);
    struct HashNode* curr = map->buckets[idx];
    while (curr != NULL) {
        if (curr->key == key) {
            return curr;
        }
        curr = curr->next;
    }
    return NULL;
}

void freeMap(struct HashMap* map) {
    for (int i = 0; i < map->size; i++) {
        struct HashNode* curr = map->buckets[i];
        while (curr != NULL) {
            struct HashNode* temp = curr;
            curr = curr->next;
            free(temp);
        }
    }
    free(map->buckets);
    free(map);
}

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* twoSum(int* nums, int numsSize, int target, int* returnSize) {
    // We allocate a hash map size proportional to the number of elements
    int mapSize = numsSize * 2; 
    struct HashMap* map = createMap(mapSize);
    
    int* result = (int*)malloc(2 * sizeof(int));
    *returnSize = 2;

    for (int i = 0; i < numsSize; i++) {
        int complement = target - nums[i];
        struct HashNode* node = search(map, complement);
        
        if (node != NULL) {
            result[0] = node->value;
            result[1] = i;
            freeMap(map); // Clean up memory before returning
            return result;
        }
        
        insert(map, nums[i], i);
    }
    
    // In case no solution is found (though the problem guarantees exactly one)
    freeMap(map);
    *returnSize = 0;
    return NULL;
}
